    "agent.tool.ask_user" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人に選択肢で質問する。文書を読んで決める判断（計画の承認・設計の選択・2 問以上の判断）に使い、会話の流れの中で決める判断は AskUserQuestion、手作業の依頼は work_update の blocker_kind manual で頼む。前提（背景・判断材料・trade-off）を context に書く。context の無い呼び出しは断る（name に publish 済みの文書名を渡すときを除く）。前提が長いときと、質問を本文の途中に置くときは、doc_publish の questions と本文の印 <!-- ask: q1 --> を使う。質問は文書（既定 questions.md）に載り、受信箱の「対応待ち」に出る。ブロックしないので、呼んだ後は作業を続けるか、止まって待つ。回答は taskboard がこのセッションに届ける（host の会話では人の発言として入り、taskboard の外の Claude Code では Stop hook が渡す。届かなければ feedback_list で取る）"
          }
        }
      }
    },
    "agent.tool.ask_user.context" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問の前に読ませる markdown（背景・判断材料・trade-off）。新しい文書に載せるときは必須。本文に <!-- ask: q1 --> を置くと、その位置に質問の欄が出る（印の無い質問は本文の末尾）"
          }
        }
      }
    },
    "agent.tool.ask_user.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
