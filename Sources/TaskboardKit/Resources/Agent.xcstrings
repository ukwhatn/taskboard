    "agent.tool.watch_cancel" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "監視を取り消す（有効な監視だけ）。通知していない動きも通知しない"
          }
        }
      }
    },
    "agent.tool.watch_create" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub の issue・PR か、このマシンで回すコマンドを監視し、動きがあれば会話へ通知する。止まった会話・終了した会話・人が停止した会話は再開して通知し、session_list に戻す。GitHub は動き（マージ・クローズ・コメント・レビュー・CI・conflict など）を、作った時点の状態を基準に通知し、それ以前の動きと自分（gh のアカウント）のコメント・レビュー・issue・PR は通知しない。command は daemon が interval_seconds ごとに bash で回し、条件に合わない状態から合う状態に変わったときに、終了コードと出力の末尾を添えて通知する（1 回目で合えばすぐ通知する）。会話を動かしたまま待たずに、セッションの外で結果を待つときに使う。タスクにリンクした PR の動きは監視しなくても lead に通知されるので、lead 宛てで events・tag_pattern・once・expires_at の無い PR の監視は作らず、PR をリンクして prompt をリンクのメモに残す（通知の「作成時の指示:」に載る）"
          }
        }
      }
    },
    "agent.tool.watch_create.command" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマシンで回すシェルのコマンド（/bin/bash -c。ログインシェルの環境で動き、標準入力は空）。例: curl -fsS https://example.com/health、test -f /tmp/done"
          }
        }
      }
